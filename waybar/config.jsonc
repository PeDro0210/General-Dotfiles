{
  "layer": "top",
  "spacing": 0,
  "height": 0,
  "margin-top": 5,
  "margin-right": 10,
  "margin-bottom": 0,
  "margin-left": 10,
  "modules-right": [
    "clock"
  ],
  "modules-left": [
    "hyprland/workspaces"
  ],
  "hyprland/workspaces": {
    "format": " {icon} ",
    "disable-scroll": true,
  },
  "tray": {
    "spacing": 10,
    "tooltip": false
  },
  "clock": {
    "format": "{:%a %d, %I:%M %p}",
    "tooltip": false
  }
}
