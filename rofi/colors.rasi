* {
    
  bg     : #201F1E;
  border : #464544;
  fg0     : #F6F6F4;
  fg1     : #E6E6E1;
  fg2     : #A4A4A2;
  red     : #E6E6E1;
  green   : #6F6E68;
  yellow  : #C5837D;
  blue    : #A91F1D;
  magenta : #51508C;
  cyan    : #231E19;

  accent: #C5837D;
  urgent: @yellow;

  background-color : transparent;
  text-color       : @fg0;

}
