* {
    
  bg     : #151213;
  border : #3C3A3B;
  fg0     : #FAF9F6;
  fg1     : #F0EEE6;
  fg2     : #A7A7A4;
  red     : #F0EEE6;
  green   : #AC8E69;
  yellow  : #B5B2E3;
  blue    : #8E6779;
  magenta : #C70E06;
  cyan    : #664717;

  accent: #B5B2E3;
  urgent: @yellow;

  background-color : transparent;
  text-color       : @fg0;

}
