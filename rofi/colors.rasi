* {
    
  bg     : #17151E;
  border : #3F3C46;
  fg0     : #BEBFCD;
  fg1     : #444870;
  fg2     : #6B6C7A;
  red     : #444870;
  green   : #0000A1;
  yellow  : #2A2867;
  blue    : #030275;
  magenta : #111058;
  cyan    : #11103D;

  accent: #2A2867;
  urgent: @yellow;

  background-color : transparent;
  text-color       : @fg0;

}
