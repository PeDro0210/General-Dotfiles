* {
    
  bg     : #262335;
  border : #011627;
  fg0     : #FFFFFF;
  fg1     : #03EDF9;
  fg2     : #575656;
  red     : #03EDF9;
  green   : #03EDF9;
  yellow  : #FF7EDB;
  blue    : #FEDE5D;
  magenta : #72F1B8;
  cyan    : #FE4450;

  accent: #FF7EDB;
  urgent: @yellow;

  background-color : transparent;
  text-color       : @fg0;

}
