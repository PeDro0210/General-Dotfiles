{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "~/Documents/Shell-Scripts/wlogout/shutdown.sh",
    "text" : "Shutdown",
    "keybind" : "s"
}
{
    "label" : "logout",
    "action" : "loginctl kill-session '' --signal=SIGINT",
    "text" : "Logout",
    "keybind" : "l"
}


