SELECT
  accountID,
  json_extract(thread, '$.extra.bridgeName') AS bridgeID,
  GROUP_CONCAT(DISTINCT json_extract(thread, '$.extra.bridge.protocol.id')) AS protocolIDs,
  CASE
    WHEN threadID LIKE '%.localhost' THEN 'local'
    WHEN json_extract(thread, '$.extra.bridge."com.beeper.self_hosted"') = 1 THEN 'self-hosted'
    ELSE 'cloud'
  END AS bridgeProvider,
  CASE
    WHEN threadID LIKE '%.localhost' THEN json_extract(thread, '$.extra.bridge.channel."fi.mau.receiver"')
    ELSE json_extract(thread, '$.extra.bridgeName')
  END AS remoteID
FROM
  threads
WHERE
  json_extract(thread, '$.extra.bridge.protocol.id') IS NOT NULL
  AND json_extract(thread, '$.extra.roomType') IS NOT 'm.space'
  AND (threadID LIKE '%.local' OR threadID LIKE '%.localhost')
GROUP BY
  bridgeID,
  accountID
ORDER BY
  accountID

