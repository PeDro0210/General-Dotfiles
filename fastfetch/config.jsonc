{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/assets/mik-chan.jpg",
    "type": "iterm",
    "height": 20,
    "width": 40,

    "padding": {
      "top": 1
    }
  },
  "display": {
    "separator": " ›  "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "OS  ",
      "keyColor": "31", // = color1
    },
    {
      "type": "kernel",
      "key": "KER ",
      "keyColor": "34",
    },
    {
      "type": "shell",
      "key": "SH  ",
      "keyColor": "34",
    },
    {
      "type": "terminal",
      "key": "TER ",
      "keyColor": "35",
    },
    {
      "type": "wm",
      "key": "WM  ",
      "keyColor": "36",
    },
    "break",
    "colors"
  ]
}
